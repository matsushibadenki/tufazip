{
  "productName": "TufaZIP", "version": "0.1.0", "identifier": "studio.tufazip.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "TufaZIP", "width": 390, "height": 551, "minWidth": 340, "minHeight": 455, "titleBarStyle":"Overlay", "hiddenTitle":true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns","icons/icon.png"], "macOS": { "signingIdentity": "-" } }
}
